# AgentPassport — environment template. Copy to backend/.env and adjust.
# NEVER commit real credentials or production keys.

# --- runtime ---------------------------------------------------------------
APP_ENV=development                     # development | production
APP_LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
# Development default: local SQLite (zero-config).
APP_DATABASE_URL=sqlite:///./agentpassport.db
# Docker Compose / production (PostgreSQL):
# APP_DATABASE_URL=postgresql+psycopg://agentpassport:CHANGE_ME@db:5432/agentpassport

# --- auth (spec §72) ----------------------------------------------------------
# Key for mutating endpoints. CHANGE THIS in any shared environment.
APP_ADMIN_API_KEY=dev-admin-key-change-me
# Optional: require a key for reads too (unset = open reads in development)
# APP_READ_API_KEY=

# --- keys ---------------------------------------------------------------------
# Directory for server-managed Ed25519 private keys (dev/demo).
# Production: inject from a secret manager; see SECURITY.md "Key custody".
APP_SECRET_KEYS_PATH=./keys

# --- API behavior ---------------------------------------------------------------
APP_RATE_LIMIT_PER_MINUTE=120
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
APP_PUBLIC_BASE_URL=http://localhost:8000

# --- background jobs --------------------------------------------------------------
APP_JOBS_ENABLED=true
APP_JOBS_INTERVAL_SECONDS=300
